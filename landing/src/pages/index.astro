            <a
              href={appUrl}
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-400 px-6 py-3.5 text-base font-bold text-ink-950 shadow-lg shadow-amber-400/20 transition hover:bg-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300"
            >
              Mở ứng dụng PWA
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-900/60">Launch PWA App</span>
            </a>
            <a
              href="#demo"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 bg-white/10 px-6 py-3.5 text-base font-bold text-cream-50 transition hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream-50"
            >
              Chạy demo Bà Lan
