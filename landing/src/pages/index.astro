  <script>
    import gsap from 'gsap';
    import { initLang, setLang, subscribeLang } from '../lib/i18n';

    initLang();

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]'));
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setLang(button.dataset.langBtn === 'vi' ? 'vi' : 'en');
      });
    });
    subscribeLang((lang) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.langBtn === lang));
      });
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.fromTo(
        '[data-hero-copy]',
        { y: 26, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out' },
      );
      gsap.fromTo(
        '[data-hero-visual]',
        { y: 34, opacity: 0, scale: 0.97 },
        { y: 0, opacity: 1, scale: 1, duration: 1.1, delay: 0.12, ease: 'power3.out' },
      );
      gsap.fromTo(
        '[data-hero-shield]',
        { scale: 0.55, opacity: 0, rotate: -10 },
        { scale: 1, opacity: 1, rotate: 0, duration: 0.9, delay: 0.28, ease: 'back.out(1.7)' },
      );
      gsap.fromTo(
        '[data-timeline-step]',
        { x: -16, opacity: 0 },
        { x: 0, opacity: 1, stagger: 0.09, duration: 0.55, delay: 0.36, ease: 'power3.out' },
      );
    }
  </script>
