                <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <p class="mt-4 text-sm text-cream-50/60">
            Bản PWA trực tuyến chạy tại <code class="rounded bg-white/10 px-1.5 py-0.5 text-cream-50/80">https://scamkill-pwa.9ez.workers.dev</code> (local: <code class="rounded bg-white/10 px-1.5 py-0.5 text-cream-50/80">http://localhost:8081</code>).
          </p>
        </div>

        <!-- Hero visual -->
        <div class="reveal relative mx-auto w-full max-w-md" aria-label="Minh hoạ luồng bảo vệ của ScamKill">
