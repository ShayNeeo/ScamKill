---
import Layout from '../layouts/Layout.astro';
import InteractiveGuidebook from '../components/InteractiveGuidebook.svelte';

export const prerender = true;
---

<Layout
  title="ScamKill interactive guidebook: five annotated controls, one zoom lens"
  description="An annotated walkthrough of ScamKill for older adults, adult children, and competition judges. Three persona views, five numbered callouts, and a 1x, 1.5x, 2x zoom lens."
  path="/guidebook"
>
  <header class="sticky top-0 z-40 border-b border-ink-900/10 bg-cream-50/90 backdrop-blur-md">
    <div class="container-page flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5" aria-label="ScamKill home">
        <span class="grid size-9 place-items-center rounded-xl bg-ink-900 text-amber-400">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3 5 6v5c0 4.4 2.9 8.3 7 9.6 4.1-1.3 7-5.2 7-9.6V6l-7-3Z" stroke-linejoin="round" />
            <path d="m8.8 12 2.2 2.2 4.2-4.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="leading-tight">
          <span class="block font-display text-lg font-semibold tracking-tight text-ink-900">ScamKill</span>
          <span class="hidden whitespace-nowrap text-[11px] font-semibold uppercase tracking-[0.16em] text-ink-600 sm:block">by QuadDraKe</span>
        </span>
      </a>

      <nav class="hidden items-center gap-5 text-sm font-semibold text-ink-700 md:flex" aria-label="Guidebook navigation">
        <a href="/" class="transition hover:text-jade-700">
          <span class="lang-en">Home</span>
          <span class="lang-vi">Trang chủ</span>
        </a>
        <a href="/guidebook#annotations" class="transition hover:text-jade-700">
          <span class="lang-en">Annotations</span>
          <span class="lang-vi">Chú thích</span>
        </a>
        <a href="/portal" class="transition hover:text-jade-700">
          <span class="lang-en">Family portal</span>
          <span class="lang-vi">Trung tâm gia đình</span>
        </a>
      </nav>

      <div class="flex items-center gap-2">
        <div class="lang-switch" role="group" aria-label="Language / Ngôn ngữ">
          <span class="lang-switch__globe" aria-hidden="true">🌐</span>
          <button type="button" data-lang-btn="en" aria-pressed="true">EN</button>
          <button type="button" data-lang-btn="vi" aria-pressed="false">VI</button>
        </div>
        <a
          href="/"
          class="inline-flex min-h-10 items-center rounded-xl border border-ink-900/15 bg-white px-3 text-sm font-bold text-ink-800 transition hover:border-jade-600 hover:text-jade-700"
        >
          <span class="lang-en">Back</span>
          <span class="lang-vi">Quay lại</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main" class="bg-cream-50">
    <section class="border-b border-ink-900/10 py-14 sm:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end">
        <div>
          <h1 class="max-w-[22ch] font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
            <span class="lang-en">Interactive guidebook</span>
            <span class="lang-vi">Cẩm nang tương tác</span>
          </h1>
          <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-ink-700">
            <span class="lang-en">Five annotated controls, three persona views, and a zoom lens that pans to the exact feature. Built for a 68-year-old reading on a phone and for a judge reading on a laptop.</span>
            <span class="lang-vi">Năm vị trí được chú thích, ba góc nhìn và một ống kính phóng to pan tới đúng tính năng. Dành cho cụ 68 tuổi đọc trên điện thoại và giám khảo đọc trên laptop.</span>
          </p>
        </div>

        <dl class="grid grid-cols-3 gap-3 text-center">
          <div class="rounded-2xl border border-ink-900/10 bg-white px-3 py-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Callouts</span>
              <span class="lang-vi">Chú thích</span>
            </dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-ink-900">05</dd>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white px-3 py-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Personas</span>
              <span class="lang-vi">Góc nhìn</span>
            </dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-ink-900">03</dd>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white px-3 py-4">
            <dt class="text-[11px] font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Zoom</span>
              <span class="lang-vi">Phóng to</span>
            </dt>
            <dd class="mt-1 font-mono text-2xl font-bold text-ink-900">2.0x</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="annotations" class="scroll-mt-20 py-14 sm:py-20">
      <div class="container-page">
        <InteractiveGuidebook client:load />
      </div>
    </section>

    <section class="border-t border-ink-900/10 bg-white py-14 sm:py-20">
      <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14">
        <div>
          <h2 class="font-display text-3xl font-semibold leading-tight text-ink-900">
            <span class="lang-en">How to read the canvas</span>
            <span class="lang-vi">Cách đọc khung hình</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-ink-700">
            <span class="lang-en">Each curved arrow starts at a numbered circle and ends on one control. Tapping the circle pans the canvas and opens the explanation for the selected persona.</span>
            <span class="lang-vi">Mỗi mũi tên cong bắt đầu từ một vòng tròn đánh số và kết thúc ở một nút. Chạm vào vòng tròn sẽ pan khung hình và mở giải thích cho góc nhìn đang chọn.</span>
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2">
          <li class="rounded-2xl border border-ink-900/10 bg-cream-50 p-4 text-sm leading-relaxed text-ink-700">
            <span class="lang-en">1.0x shows the whole app screen with all five callouts visible.</span>
            <span class="lang-vi">1.0x hiển thị toàn bộ màn hình ứng dụng với cả năm chú thích.</span>
          </li>
          <li class="rounded-2xl border border-ink-900/10 bg-cream-50 p-4 text-sm leading-relaxed text-ink-700">
            <span class="lang-en">1.5x is the reading level for dense text and small badges.</span>
            <span class="lang-vi">1.5x là mức đọc cho chữ dày và nhãn nhỏ.</span>
          </li>
          <li class="rounded-2xl border border-ink-900/10 bg-cream-50 p-4 text-sm leading-relaxed text-ink-700">
            <span class="lang-en">2.0x is the demonstration level for a projector or a live pitch.</span>
            <span class="lang-vi">2.0x là mức trình diễn cho máy chiếu hoặc phần thi trực tiếp.</span>
          </li>
          <li class="rounded-2xl border border-ink-900/10 bg-cream-50 p-4 text-sm leading-relaxed text-ink-700">
            <span class="lang-en">Reduced-motion settings keep every pan instant and stop the pulsing rings.</span>
            <span class="lang-vi">Chế độ giảm chuyển động giữ mọi cú pan tức thì và dừng các vòng tròn nhấp nháy.</span>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="border-t border-ink-900/10 bg-cream-50 py-8">
    <div class="container-page flex flex-col gap-3 text-sm text-ink-600 sm:flex-row sm:items-center sm:justify-between">
      <p>ScamKill · QuadDraKe · HITC InnoStar 2026</p>
      <a href="/" class="font-semibold text-jade-700 underline decoration-jade-600/30 underline-offset-4 hover:decoration-jade-600">
        <span class="lang-en">Back to the landing page</span>
        <span class="lang-vi">Về trang chủ</span>
      </a>
    </div>
  </footer>

  <script>
    import { initLang, setLang, subscribeLang } from '../lib/i18n';

    initLang();

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]'));
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setLang(button.dataset.langBtn === 'vi' ? 'vi' : 'en');
      });
    });
    subscribeLang((lang) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.langBtn === lang));
      });
    });
  </script>
</Layout>
