---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import LeadAndAuthModal from '../components/LeadAndAuthModal.svelte';
import { countLeads, countReports, listLeads, listReports } from '../lib/store';
import type { FamilyLeadRow, ScamReportRow } from '../db/schema';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const { user } = Astro.locals;
const d1 = env?.DB;

let leads: FamilyLeadRow[] = [];
let reports: ScamReportRow[] = [];
let leadTotal = 0;
let reportTotal = 0;

if (user) {
  [leads, reports, leadTotal, reportTotal] = await Promise.all([
    listLeads(d1, 8),
    listReports(d1, 8),
    countLeads(d1),
    countReports(d1),
  ]);
}

type Bi = { en: string; vi: string };

const roleLabel: Record<string, Bi> = {
  senior: { en: 'Older adult', vi: 'Người cao tuổi' },
  family: { en: 'Family', vi: 'Gia đình' },
  bank: { en: 'Bank', vi: 'Ngân hàng' },
  telco: { en: 'Telecom carrier', vi: 'Nhà mạng' },
  other: { en: 'Other', vi: 'Khác' },
};

const categoryLabel: Record<string, Bi> = {
  authority_impersonation: { en: 'Authority impersonation', vi: 'Giả danh cơ quan' },
  relative_emergency: { en: 'Fake family emergency', vi: 'Giả tai nạn người thân' },
  otp_or_money_demand: { en: 'OTP or money demand', vi: 'Đòi OTP hoặc chuyển tiền' },
  suspicious_url: { en: 'Suspicious link', vi: 'Đường link lạ' },
  malicious_app_install: { en: 'Forced app install', vi: 'Ép cài ứng dụng' },
  unknown: { en: 'Unclassified', vi: 'Chưa phân loại' },
};

function maskPhone(phone: string): string {
  return phone.length >= 7 ? `${phone.slice(0, 4)}***${phone.slice(-3)}` : '***';
}

function formatDate(ms: number): string {
  return new Intl.DateTimeFormat('en-GB', {
    dateStyle: 'short',
    timeStyle: 'short',
    timeZone: 'Asia/Ho_Chi_Minh',
  }).format(new Date(ms));
}
---

<Layout title="Dashboard · ScamKill" description="Test dashboard for leads, sign-in sessions, and scam reports.">
  <header class="border-b border-ink-900/10 bg-cream-50">
    <div class="container-page flex h-16 items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-2.5" aria-label="ScamKill home">
        <span class="grid size-9 place-items-center rounded-xl bg-ink-900 text-amber-400">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3 5 6v5c0 4.4 2.9 8.3 7 9.6 4.1-1.3 7-5.2 7-9.6V6l-7-3Z" stroke-linejoin="round" />
            <path d="m8.8 12 2.2 2.2 4.2-4.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="font-display text-lg font-semibold text-ink-900">ScamKill</span>
      </a>
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <div class="lang-switch" role="group" aria-label="Language / Ngôn ngữ">
          <iconify-icon icon="lucide:globe" width="15" height="15" class="lang-switch__globe" aria-hidden="true"></iconify-icon>
          <button type="button" data-lang-btn="en" aria-pressed="true">EN</button>
          <button type="button" data-lang-btn="vi" aria-pressed="false">VI</button>
        </div>
        <a href="/" class="hidden text-sm font-semibold text-ink-700 hover:text-jade-700 sm:inline">
          <span class="lang-en">Home</span>
          <span class="lang-vi">Trang chủ</span>
        </a>
        {user && (
          <button
            type="button"
            id="logout"
            class="rounded-xl border border-ink-900/15 bg-white px-3 py-2 text-sm font-bold text-ink-900 transition hover:border-clay-500 hover:text-clay-600"
          >
            <span class="lang-en">Sign out</span>
            <span class="lang-vi">Đăng xuất</span>
          </button>
        )}
      </div>
    </div>
  </header>

  <main id="main" class="container-page py-12">
    {!user ? (
      <div class="mx-auto max-w-lg rounded-3xl border border-ink-900/10 bg-white p-8 text-center shadow-sm">
        <h1 class="font-display text-2xl font-semibold text-ink-900">
          <span class="lang-en">Sign-in required</span>
          <span class="lang-vi">Cần đăng nhập</span>
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          <span class="lang-en">The dashboard shows pilot leads and the latest scam reports. Use a team account or create a test account: passwords are hashed with PBKDF2 and sessions are stored in an HttpOnly cookie.</span>
          <span class="lang-vi">Bảng điều khiển hiển thị lead đăng ký thử nghiệm và báo cáo lừa đảo gần nhất. Dùng tài khoản đội ngũ hoặc tạo tài khoản thử nghiệm: mật khẩu được băm PBKDF2 và phiên lưu bằng cookie HttpOnly.</span>
        </p>
        <div class="mt-6 flex justify-center">
          <LeadAndAuthModal client:load initialMode="auth" variant="primary" />
        </div>
        <p class="mt-4 text-xs text-ink-600">
          <span class="lang-en">No D1 configured? Run</span>
          <span class="lang-vi">Chưa cấu hình D1? Chạy</span>
          <code class="rounded bg-cream-50 px-1.5 py-0.5">pnpm db:migrate:local</code>.
        </p>
      </div>
    ) : (
      <div>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h1 class="font-display text-3xl font-semibold text-ink-900">
              <span class="lang-en">Hello, {user.name}</span>
              <span class="lang-vi">Xin chào, {user.name}</span>
            </h1>
            <p class="mt-1 text-sm text-ink-600">{user.email} ·
              <span class="lang-en">session expires in 30 days</span>
              <span class="lang-vi">phiên hết hạn sau 30 ngày</span>
            </p>
          </div>
          <p class="rounded-full border border-ink-900/10 bg-white px-3 py-1.5 text-xs font-semibold text-ink-700">
            D1:
            <span class="lang-en">{d1 ? 'connected' : 'in-memory (dev)'}</span>
            <span class="lang-vi">{d1 ? 'đã kết nối' : 'bộ nhớ tạm (dev)'}</span>
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Pilot leads</span>
              <span class="lang-vi">Lead thử nghiệm</span>
            </p>
            <p class="mt-2 text-3xl font-bold text-ink-900">{leadTotal}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Scam reports</span>
              <span class="lang-vi">Báo cáo lừa đảo</span>
            </p>
            <p class="mt-2 text-3xl font-bold text-ink-900">{reportTotal}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Current user</span>
              <span class="lang-vi">Người dùng hiện tại</span>
            </p>
            <p class="mt-2 truncate text-lg font-bold text-ink-900">{user.name}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              <span class="lang-en">Session</span>
              <span class="lang-vi">Phiên</span>
            </p>
            <p class="mt-2 text-sm font-semibold text-jade-700">Cookie HttpOnly · SameSite Lax</p>
          </div>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <section class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
            <div class="flex items-center justify-between border-b border-ink-900/10 px-5 py-4">
              <h2 class="font-display text-xl font-semibold text-ink-900">
                <span class="lang-en">Latest leads</span>
                <span class="lang-vi">Lead mới nhất</span>
              </h2>
              <span class="text-xs text-ink-600">
                <span class="lang-en">max 8</span>
                <span class="lang-vi">tối đa 8</span>
              </span>
            </div>
            {leads.length === 0 ? (
              <p class="px-5 py-8 text-sm text-ink-600">
                <span class="lang-en">No leads yet. Submit the form on the landing page.</span>
                <span class="lang-vi">Chưa có lead nào. Gửi thử form trên trang chủ.</span>
              </p>
            ) : (
              <ul class="divide-y divide-ink-900/10">
                {leads.map((lead) => (
                  <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3.5">
                    <div>
                      <p class="text-sm font-bold text-ink-900">{lead.name}</p>
                      <p class="text-xs text-ink-600">
                        {maskPhone(lead.phone)} ·
                        <span class="lang-en">{(roleLabel[lead.role] ?? roleLabel.other).en}</span>
                        <span class="lang-vi">{(roleLabel[lead.role] ?? roleLabel.other).vi}</span>
                        {lead.city ? ` · ${lead.city}` : ''}
                      </p>
                    </div>
                    <time class="text-xs text-ink-600" datetime={new Date(lead.createdAt).toISOString()}>{formatDate(lead.createdAt)}</time>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
            <div class="flex items-center justify-between border-b border-ink-900/10 px-5 py-4">
              <h2 class="font-display text-xl font-semibold text-ink-900">
                <span class="lang-en">Latest reports</span>
                <span class="lang-vi">Báo cáo gần nhất</span>
              </h2>
              <span class="text-xs text-ink-600">
                <span class="lang-en">max 8</span>
                <span class="lang-vi">tối đa 8</span>
              </span>
            </div>
            {reports.length === 0 ? (
              <p class="px-5 py-8 text-sm text-ink-600">
                <span class="lang-en">No reports yet. Send one through</span>
                <span class="lang-vi">Chưa có báo cáo. Gửi qua</span>
                <code>POST /api/reports</code>.
              </p>
            ) : (
              <ul class="divide-y divide-ink-900/10">
                {reports.map((report) => (
                  <li class="px-5 py-3.5">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-sm font-bold text-ink-900">{maskPhone(report.phoneNumber)}</p>
                      <span class="rounded-full bg-cream-50 px-2 py-0.5 text-[11px] font-semibold text-ink-700">{report.status}</span>
                    </div>
                    <p class="mt-1 text-xs text-ink-600">
                      <span class="lang-en">{(categoryLabel[report.category] ?? categoryLabel.unknown).en}</span>
                      <span class="lang-vi">{(categoryLabel[report.category] ?? categoryLabel.unknown).vi}</span>
                      · {report.channel} · {formatDate(report.createdAt)}
                    </p>
                    {report.description && <p class="mt-1 text-sm text-ink-700">{report.description}</p>}
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      </div>
    )}
  </main>

  <footer class="border-t border-ink-900/10 py-6">
    <div class="container-page text-xs text-ink-600">
      <span class="lang-en">Lead and report data are used for the pilot only. Never enter an OTP, card number, or banking details.</span>
      <span class="lang-vi">Dữ liệu lead và báo cáo chỉ dùng cho chương trình thử nghiệm. Không nhập OTP, số thẻ hay thông tin ngân hàng.</span>
    </div>
  </footer>

  <script>
    import { initLang, setLang, subscribeLang } from '../lib/i18n';

    initLang();

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lang-btn]'));
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        setLang(button.dataset.langBtn === 'vi' ? 'vi' : 'en');
      });
    });
    subscribeLang((lang) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.langBtn === lang));
      });
    });

    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/session', { method: 'DELETE' });
      window.location.assign('/');
    });
  </script>
</Layout>
