---
import Layout from '../layouts/Layout.astro';
import LeadAndAuthModal from '../components/LeadAndAuthModal.svelte';
import { countLeads, countReports, listLeads, listReports } from '../lib/store';
import type { FamilyLeadRow, ScamReportRow } from '../db/schema';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

const { user } = Astro.locals;
const d1 = Astro.locals.runtime?.env?.DB;

let leads: FamilyLeadRow[] = [];
let reports: ScamReportRow[] = [];
let leadTotal = 0;
let reportTotal = 0;

if (user) {
  [leads, reports, leadTotal, reportTotal] = await Promise.all([
    listLeads(d1, 8),
    listReports(d1, 8),
    countLeads(d1),
    countReports(d1),
  ]);
}

const roleLabel: Record<string, string> = {
  senior: 'Người cao tuổi',
  family: 'Gia đình',
  bank: 'Ngân hàng',
  telco: 'Nhà mạng',
  other: 'Khác',
};

const categoryLabel: Record<string, string> = {
  authority_impersonation: 'Giả danh cơ quan',
  relative_emergency: 'Giả tai nạn người thân',
  otp_or_money_demand: 'Đòi OTP / chuyển tiền',
  suspicious_url: 'Đường link lạ',
  malicious_app_install: 'Ép cài ứng dụng',
  unknown: 'Chưa phân loại',
};

function maskPhone(phone: string): string {
  return phone.length >= 7 ? `${phone.slice(0, 4)}***${phone.slice(-3)}` : '***';
}

function formatDate(ms: number): string {
  return new Intl.DateTimeFormat('vi-VN', {
    dateStyle: 'short',
    timeStyle: 'short',
    timeZone: 'Asia/Ho_Chi_Minh',
  }).format(new Date(ms));
}
---

<Layout title="Bảng điều khiển — ScamKill" description="Bảng điều khiển thử nghiệm lead, phiên đăng nhập và báo cáo lừa đảo.">
  <header class="border-b border-ink-900/10 bg-cream-50">
    <div class="container-page flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <span class="grid size-9 place-items-center rounded-xl bg-ink-900 text-amber-400">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3 5 6v5c0 4.4 2.9 8.3 7 9.6 4.1-1.3 7-5.2 7-9.6V6l-7-3Z" stroke-linejoin="round" />
            <path d="m8.8 12 2.2 2.2 4.2-4.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="font-serif text-lg font-semibold text-ink-900">ScamKill</span>
      </a>
      <div class="flex items-center gap-3">
        <a href="/" class="text-sm font-semibold text-ink-700 hover:text-jade-700">Về trang chủ</a>
        {user && (
          <button
            type="button"
            id="logout"
            class="rounded-xl border border-ink-900/15 bg-white px-3 py-2 text-sm font-bold text-ink-900 transition hover:border-clay-500 hover:text-clay-600"
          >
            Đăng xuất
          </button>
        )}
      </div>
    </div>
  </header>

  <main id="main" class="container-page py-12">
    {!user ? (
      <div class="mx-auto max-w-lg rounded-3xl border border-ink-900/10 bg-white p-8 text-center shadow-sm">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-jade-700">Khu vực thử nghiệm</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold text-ink-900">Cần đăng nhập</h1>
        <p class="mt-3 text-sm leading-relaxed text-ink-700">
          Bảng điều khiển hiển thị lead đăng ký thử nghiệm và báo cáo lừa đảo gần nhất. Dùng tài khoản
          đội ngũ hoặc tạo tài khoản thử nghiệm — mật khẩu được băm PBKDF2 và phiên lưu bằng cookie HttpOnly.
        </p>
        <div class="mt-6 flex justify-center">
          <LeadAndAuthModal client:load triggerLabel="Đăng nhập / tạo tài khoản" initialMode="auth" variant="primary" />
        </div>
        <p class="mt-4 text-xs text-ink-600">
          Chưa cấu hình D1? Chạy <code class="rounded bg-cream-50 px-1.5 py-0.5">pnpm db:migrate:local</code>.
        </p>
      </div>
    ) : (
      <div>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-jade-700">Bảng điều khiển</p>
            <h1 class="mt-2 font-serif text-3xl font-semibold text-ink-900">Xin chào, {user.name}</h1>
            <p class="mt-1 text-sm text-ink-600">{user.email} · phiên hết hạn sau 30 ngày</p>
          </div>
          <p class="rounded-full border border-ink-900/10 bg-white px-3 py-1.5 text-xs font-semibold text-ink-700">
            D1: {d1 ? 'đã kết nối' : 'bộ nhớ tạm (dev)'}
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">Lead thử nghiệm</p>
            <p class="mt-2 text-3xl font-bold text-ink-900">{leadTotal}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">Báo cáo lừa đảo</p>
            <p class="mt-2 text-3xl font-bold text-ink-900">{reportTotal}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">Người dùng hiện tại</p>
            <p class="mt-2 truncate text-lg font-bold text-ink-900">{user.name}</p>
          </div>
          <div class="rounded-2xl border border-ink-900/10 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-ink-600">Phiên</p>
            <p class="mt-2 text-sm font-semibold text-jade-700">Cookie HttpOnly · SameSite Lax</p>
          </div>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <section class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
            <div class="flex items-center justify-between border-b border-ink-900/10 px-5 py-4">
              <h2 class="font-serif text-xl font-semibold text-ink-900">Lead mới nhất</h2>
              <span class="text-xs text-ink-600">tối đa 8</span>
            </div>
            {leads.length === 0 ? (
              <p class="px-5 py-8 text-sm text-ink-600">Chưa có lead nào. Gửi thử form trên trang chủ.</p>
            ) : (
              <ul class="divide-y divide-ink-900/10">
                {leads.map((lead) => (
                  <li class="flex flex-wrap items-center justify-between gap-2 px-5 py-3.5">
                    <div>
                      <p class="text-sm font-bold text-ink-900">{lead.name}</p>
                      <p class="text-xs text-ink-600">{maskPhone(lead.phone)} · {roleLabel[lead.role] ?? lead.role}{lead.city ? ` · ${lead.city}` : ''}</p>
                    </div>
                    <time class="text-xs text-ink-600" datetime={new Date(lead.createdAt).toISOString()}>{formatDate(lead.createdAt)}</time>
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section class="overflow-hidden rounded-2xl border border-ink-900/10 bg-white">
            <div class="flex items-center justify-between border-b border-ink-900/10 px-5 py-4">
              <h2 class="font-serif text-xl font-semibold text-ink-900">Báo cáo gần nhất</h2>
              <span class="text-xs text-ink-600">tối đa 8</span>
            </div>
            {reports.length === 0 ? (
              <p class="px-5 py-8 text-sm text-ink-600">Chưa có báo cáo. Gửi qua <code>POST /api/reports</code>.</p>
            ) : (
              <ul class="divide-y divide-ink-900/10">
                {reports.map((report) => (
                  <li class="px-5 py-3.5">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <p class="text-sm font-bold text-ink-900">{maskPhone(report.phoneNumber)}</p>
                      <span class="rounded-full bg-cream-50 px-2 py-0.5 text-[11px] font-semibold text-ink-700">{report.status}</span>
                    </div>
                    <p class="mt-1 text-xs text-ink-600">
                      {categoryLabel[report.category] ?? report.category} · {report.channel} · {formatDate(report.createdAt)}
                    </p>
                    {report.description && <p class="mt-1 text-sm text-ink-700">{report.description}</p>}
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>
      </div>
    )}
  </main>

  <footer class="border-t border-ink-900/10 py-6">
    <div class="container-page text-xs text-ink-600">
      Dữ liệu lead và báo cáo chỉ dùng cho chương trình thử nghiệm. Không nhập OTP, số thẻ hay thông tin ngân hàng.
    </div>
  </footer>

  <script is:inline>
    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/auth/session', { method: 'DELETE' });
      window.location.assign('/');
    });
  </script>
</Layout>
