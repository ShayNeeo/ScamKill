---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'ScamKill: an AI shield against phone scams for older adults',
  description = 'ScamKill helps older adults and their families stop phone scams together: warn before pickup, analyze suspicious messages, and alert a trusted person in one tap over SMS, Zalo, and Telegram.',
  path = '/',
} = Astro.props;

const canonical = Astro.site ? new URL(path, Astro.site).toString() : undefined;
const ogImage = canonical ? new URL('/favicon.svg', canonical).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1f1c" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://scamkill-pwa.9ez.workers.dev" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@500;700&family=Atkinson+Hyperlegible:wght@400;700&family=Bricolage+Grotesque:wght@600;700;800&display=swap"
    />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://api.iconify.design" crossorigin />
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@2.3.0/dist/iconify-icon.min.js" defer></script>
    <script is:inline>
      try {
        document.documentElement.lang = localStorage.getItem('scamkill.lang') === 'vi' ? 'vi' : 'en';
      } catch (error) {
        document.documentElement.lang = 'en';
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      <span class="lang-en">Skip to main content</span>
      <span class="lang-vi">Bỏ qua điều hướng</span>
    </a>
    <slot />
  </body>
</html>
