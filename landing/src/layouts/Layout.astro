---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'ScamKill — Lá chắn AI chống lừa đảo qua điện thoại cho người cao tuổi',
  description = 'ScamKill giúp người cao tuổi và gia đình cùng chống lừa đảo: cảnh báo trước khi bắt máy, phân tích tin nhắn đáng ngờ, Mã gia đình và báo người thân 1-chạm qua SMS, Zalo, Telegram.',
  path = '/',
} = Astro.props;

const canonical = Astro.site ? new URL(path, Astro.site).toString() : undefined;
const ogImage = canonical ? new URL('/favicon.svg', canonical).toString() : undefined;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1f1c" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="robots" content="index, follow" />
    <link rel="preconnect" href="https://scamkill-pwa.9ez.workers.dev" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      Bỏ qua điều hướng
    </a>
    <slot />
  </body>
</html>
