{
  "name": "scamkill-landing",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsrs": "tsrs --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply scamkill-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply scamkill-db --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@astrojs/svelte": "^8.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "astro": "^6.4.8",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "motion": "^14.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  }
}
