{
  "expo": {
    "name": "ScamKill",
    "slug": "scamkill",
    "version": "1.0.0",
    "description": "Lá chắn AI giúp người cao tuổi và gia đình cùng chống lừa đảo qua điện thoại",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scamkill",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "vn.quaddrake.scamkill",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.quaddrake.scamkill"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ScamKill - Lá chắn chống lừa đảo",
      "shortName": "ScamKill",
      "themeColor": "#0B5D56",
      "backgroundColor": "#FAF6EE"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
